# =============================================================================
# Torres — variáveis de ambiente (EXEMPLO SEM VALORES)
# Copie para .env e preencha. NUNCA commitar .env.
# Destinos: Local | Vercel (Development/Preview/Production)
# Não há Edge Functions Supabase neste projeto — secrets vão para a Vercel.
# =============================================================================

# --- Runtime local / compartilhado ---
# Destino: Local + Vercel | Sigilo: baixo
TZ=America/Sao_Paulo
PORT=5000
NODE_ENV=development

# URL pública do site (webhooks, e-mails, links)
# Destino: Vercel (todos) + Local | Sigilo: público (URL)
PUBLIC_SITE_URL=

# --- Supabase (obrigatório) ---
# Destino: Vercel privada + Local | Sigilo: ANON pública via VITE_; SERVICE_ROLE privada
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
DATABASE_URL=

# Frontend (expostas no bundle — apenas URL + anon com RLS)
# Destino: Vercel (build) | Sigilo: público controlado
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Auth / segurança app ---
# Destino: Vercel privada + Local | Sigilo: alto
SESSION_SECRET=
CONTROLID_ENC_KEY=
CRON_SECRET=

# --- E-mail (SMTP) ---
# Destino: Vercel privada + Local | Sigilo: alto
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_FROM=
SMTP_PASS=

# --- Google Maps ---
# VITE_ é pública no browser; GOOGLE_MAPS_API_KEY fica no backend
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Asaas (cobrança / NFS-e) ---
# Destino: Vercel privada | Sigilo: alto
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_MUNICIPAL_SERVICE_ID=
ASAAS_WEBHOOK_TOKEN=

# --- Banco Inter (opcional; ausência desativa módulo) ---
# Destino: Vercel privada | Sigilo: alto (certs)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CONTA_CORRENTE=
INTER_CERT_CRT=
INTER_CERT_KEY=
INTER_AMBIENTE=

# --- Z-API (WhatsApp) ---
# Destino: Vercel privada | Sigilo: alto
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_EXPECTED_PHONE=

# --- OpenAI / IA ---
# Destino: Vercel privada | Sigilo: alto
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Consultas / documentos (APIBrasil etc.) ---
# Destino: Vercel privada | Sigilo: alto
APIBRASIL_TOKEN=
APIBRASIL_DEVICE_NOTAS=
APIBRASIL_DEVICE_PROCESSOS=
APIBRASIL_DEVICE_CNH=
APIBRASIL_DEVICE_CERTIDAO_PJ=
APIBRASIL_DEVICE_MULTAS=
APIBRASIL_DEVICE_PROTESTO=
APIBRASIL_DEVICE_QUOD=
APIBRASIL_DEVICE_RISCO_PJ=
APIBRASIL_DEVICE_SPC=
APIBRASIL_DEVICE_ELEITORAL=
APIBRASIL_DEVICE_PLACA_DADOS=
APIBRASIL_DEVICE_TOKEN=
APIBRASIL_SOCKET_CHANNEL=
RECEITAWS_TOKEN=
WDAPI_TOKEN=
BRASILAPI_TOKEN=

# --- Telemetria / câmeras ---
TRUCKSCONTROL_CHAVE=
TRUCKSCONTROL_SENHA=
SSX_BASE_URL=
SSX_EMAIL=
SSX_PASSWORD=
SSX_TOKEN=

# --- TicketLog (API auto desativada; CSV/manual ainda usa libs) ---
# Situação: obsoleta para API automática; manter só se conciliação precisar
TICKETLOG_USER=
TICKETLOG_PASS=
TICKETLOG_ENV=

# --- RHID / Control iD ---
RHID_API_URL=
RHID_EMAIL=

# --- Flags ---
DISABLE_LOCAL_FALLBACK=
